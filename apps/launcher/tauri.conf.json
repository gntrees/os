{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gntrees-launcher",
  "version": "0.1.0",
  "identifier": "os.gntrees.launcher",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "gntrees",
        "width": 720,
        "height": 460,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
